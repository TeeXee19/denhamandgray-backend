# Email Configuration for Whistleblowing Reports
# Copy these variables to your .env file and replace with actual values

# Outlook SMTP Configuration
OUTLOOK_SMTP_HOST=smtp-mail.outlook.com
OUTLOOK_SMTP_PORT=587

# Email Credentials (replace with actual Outlook account credentials)
OUTLOOK_EMAIL_USER=your-outlook-email@outlook.com
OUTLOOK_EMAIL_PASSWORD=your-outlook-app-password

# Recipient email for whistleblowing reports (can be the same as sender or different)
WHISTLEBLOWING_RECIPIENT_EMAIL=hr@denhamandgray.com

# Note: For Outlook, you may need to:
# 1. Enable 2FA on your account
# 2. Generate an app-specific password instead of using your regular password
# 3. Or use OAuth2 for production environments